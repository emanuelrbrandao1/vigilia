{
  "manifest_version": 3,
  "name": "Vigília — Foco local",
  "version": "1.2.0",
  "icons": {"16":"icons/foco-16.png","32":"icons/foco-32.png","48":"icons/foco-48.png","128":"icons/foco-128.png"},
  "description": "Bloqueios, horários e tempo na aba ativa, compartilhados com o painel local do Windows.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {"16":"icons/foco-16.png","24":"icons/foco-24.png","32":"icons/foco-32.png"},
    "default_title": "Vigília | Foco local",
    "default_popup": "popup.html"
  },
  "incognito": "spanning",
  "key": ""
}
